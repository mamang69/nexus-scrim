# Database URL (PostgreSQL - Neon / Supabase)
# Neon connection string format:
# postgres://<user>:<password>@<endpoint>.us-east-2.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL="postgresql://neondb_owner:your_neon_password@ep-cool-frost-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="nexus_scrim_super_secret_jwt_key_1234567890"

# Discord OAuth Provider (Get from https://discord.com/developers/applications)
